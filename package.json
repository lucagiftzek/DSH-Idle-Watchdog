{
  "name": "dsh-idle-watchdog",
  "version": "1.1.0",
  "description": "DeepSeek Harness (DSH) plugin: nudge opted-in chats when they go idle (quiet hours, backoff, goal-aware, error-only mode, preview), plus a secret-protected HTTP API to prompt any chat from scripts, cron or webhooks.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node test/run.mjs && node test/client.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "idle",
    "watchdog",
    "auto-prompt",
    "followup",
    "webhook",
    "automation",
    "nudge",
    "http-api"
  ],
  "author": {
    "name": "Luca Tzekos",
    "url": "https://jobopportunitiesapi.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucagiftzek/DSH-Idle-Watchdog.git"
  },
  "homepage": "https://github.com/lucagiftzek/DSH-Idle-Watchdog#readme",
  "bugs": {
    "url": "https://github.com/lucagiftzek/DSH-Idle-Watchdog/issues"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "react-dom": "18.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
